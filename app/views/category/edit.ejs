<%- include('../partials/header', { title: title, appName: appName }) %>

<section class="auth-page">
  <div class="auth-card">
    <div class="auth-heading">
      <span class="auth-icon" aria-hidden="true">&#9998;</span>
      <h1>Edit Category</h1>
      <p class="auth-sub">Update the details for <strong><%= category.name || 'this category' %></strong>.</p>
    </div>

    <%- include('../partials/flash') %>

<form action="/admin/categories/<%= category.id %>/edit" method="POST" class="auth-form" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="form-group">
        <label for="name">Category Name *</label>
        <input
          type="text" id="name" name="name" required
          value="<%= values.name || '' %>"
          class="<%= errors.name ? 'input-error' : '' %>"
          placeholder="e.g. Analgesics"
        />
        <% if (errors.name) { %><small class="field-error"><%= errors.name %></small><% } %>
      </div>

      <div class="form-group">
        <label for="description">Description</label>
        <textarea
          id="description" name="description" rows="3"
          class="<%= errors.description ? 'input-error' : '' %>"
          placeholder="Short description of the category"
        ><%= values.description || '' %></textarea>
        <% if (errors.description) { %><small class="field-error"><%= errors.description %></small><% } %>
      </div>

      <button type="submit" class="btn btn-block">Save Changes</button>
    </form>

    <p class="auth-alt">
      <a href="/admin/categories">&larr; Back to Manage Categories</a>
    </p>
  </div>
</section>

<%- include('../partials/footer', { year: new Date().getFullYear(), appName: appName }) %>
