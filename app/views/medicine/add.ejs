<%- include('../partials/header', { title: title, appName: appName }) %>

<section class="auth-page">
  <div class="auth-card">
    <div class="auth-heading">
      <span class="auth-icon" aria-hidden="true">&#10133;</span>
      <h1>Add Medicine</h1>
      <p class="auth-sub">Create a new medicine record in the catalog.</p>
    </div>

    <%- include('../partials/flash') %>

    <%- include('_form', {
      values: values,
      errors: errors,
      categories: categories,
      formAction: '/admin/medicines',
      submitLabel: 'Add Medicine'
    }) %>

    <p class="auth-alt">
      <a href="/admin/medicines">&larr; Back to Manage Medicines</a>
    </p>
  </div>
</section>

<%- include('../partials/footer', { year: new Date().getFullYear(), appName: appName }) %>
