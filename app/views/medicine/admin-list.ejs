<%- include('../partials/header', { title: title, appName: appName }) %>

<section class="page">
  <div class="page-heading page-heading-row">
    <div>
      <h1>Manage Medicines</h1>
      <p class="page-subtitle">Add, edit, and activate or deactivate medicines.</p>
    </div>
    <div class="page-actions">
      <a href="/admin/categories" class="btn btn-sm btn-secondary">Manage Categories</a>
      <a href="/admin/medicines/add" class="btn btn-sm">+ Add Medicine</a>
    </div>
  </div>

  <%- include('../partials/flash') %>

  <% if (typeof medicines !== 'undefined' && medicines && medicines.length > 0) { %>
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col">Generic Name</th>
            <th scope="col">Category</th>
            <th scope="col">Strength</th>
            <th scope="col">Status</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% medicines.forEach(function (m) { %>
            <tr>
              <td><%= m.name %></td>
              <td><%= m.generic_name || '—' %></td>
              <td><%= m.category_name || '—' %></td>
              <td><%= m.strength || '—' %></td>
              <td>
                <% if (m.status === 'active') { %>
                  <span class="badge badge-success">Active</span>
                <% } else { %>
                  <span class="badge badge-danger">Inactive</span>
                <% } %>
              </td>
              <td class="table-actions">
                <a href="/medicines/<%= m.id %>" class="btn btn-sm btn-outline">View</a>
                <a href="/admin/medicines/<%= m.id %>/edit" class="btn btn-sm btn-secondary">Edit</a>
<% if (m.status === 'active') { %>
                  <form action="/admin/medicines/<%= m.id %>/deactivate" method="POST" class="inline-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <button type="submit" class="btn btn-sm btn-danger">Deactivate</button>
                  </form>
                <% } else { %>
                  <form action="/admin/medicines/<%= m.id %>/activate" method="POST" class="inline-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <button type="submit" class="btn btn-sm btn-success">Activate</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
<% } else { %>
    <div class="empty-state">
      <span class="state-icon" aria-hidden="true">&#128137;</span>
      <h3>No medicines added yet</h3>
      <p>No medicines have been added yet.</p>
      <div class="empty-actions">
        <a href="/admin/medicines/add" class="btn btn-sm">+ Add Medicine</a>
      </div>
    </div>
  <% } %>
</section>

<%- include('../partials/footer', { year: new Date().getFullYear(), appName: appName }) %>
