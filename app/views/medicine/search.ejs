<%- include('../partials/header', { title: title, appName: appName }) %>

<section class="page">
  <div class="page-heading">
    <h1>Search Medicines</h1>
    <p class="page-subtitle">Find a medicine by name, brand, or generic name.</p>
  </div>

  <form class="search-bar search-bar-inline" action="/medicines/search" method="GET" role="search" aria-label="Search medicines">
    <label class="sr-only" for="medicine-search">Search for a medicine</label>
    <span class="search-icon" aria-hidden="true">&#9906;</span>
    <input
      id="medicine-search"
      type="search"
      name="q"
      value="<%= typeof query !== 'undefined' && query ? query : '' %>"
      placeholder="Search medicines, brands, or generic names..."
      autocomplete="off"
    />
    <button type="submit" class="btn btn-search">Search</button>
  </form>

  <%- include('../partials/flash') %>

  <% if (typeof query !== 'undefined' && query) { %>
    <div class="search-summary">
      <% if (typeof medicines !== 'undefined' && medicines && medicines.length > 0) { %>
        <p>
          <strong><%= medicines.length %></strong> result<%= medicines.length === 1 ? '' : 's' %> found for &ldquo;<%= query %>&rdquo;
        </p>
      <% } else { %>
        <p>No results found for &ldquo;<%= query %>&rdquo;</p>
      <% } %>
    </div>
  <% } %>

  <% if (typeof medicines !== 'undefined' && medicines && medicines.length > 0) { %>
    <div class="result-list">
      <% medicines.forEach(function (m) { %>
        <a class="result-card" href="/medicines/<%= m.id %>">
          <div class="result-card-main">
            <h3 class="result-title"><%= m.name %></h3>
            <p class="result-subtitle">
              <% if (m.generic_name) { %>
                Generic: <span class="result-emphasis"><%= m.generic_name %></span>
              <% } else { %>
                Generic: <span class="muted">&mdash;</span>
              <% } %>
            </p>
          </div>
          <ul class="result-meta">
            <li>
              <span class="detail-label">Category</span>
              <span><%= m.category_name || '—' %></span>
            </li>
            <li>
              <span class="detail-label">Form</span>
              <span><%= m.dosage_form || '—' %></span>
            </li>
            <li>
              <span class="detail-label">Strength</span>
              <span><%= m.strength || '—' %></span>
            </li>
            <li>
              <span class="detail-label">Type</span>
              <span>
                <% if (m.prescription_required) { %>
                  <span class="badge badge-warning">Rx</span>
                <% } else { %>
                  <span class="badge badge-success">OTC</span>
                <% } %>
              </span>
            </li>
          </ul>
        </a>
      <% }) %>
    </div>
<% } else { %>
    <div class="empty-state">
      <span class="state-icon" aria-hidden="true">&#128269;</span>
      <% if (typeof query !== 'undefined' && query) { %>
        <h3>No results found</h3>
        <p>We couldn't find any medicines matching &ldquo;<%= query %>&rdquo;.</p>
        <p class="hint">Try a different spelling or browse by category.</p>
      <% } else { %>
        <h3>Search for a medicine</h3>
        <p>Enter a search term above to find medicines by name, brand, or generic name.</p>
        <p class="hint">Try &ldquo;Paracetamol&rdquo;, &ldquo;Ibuprofen&rdquo;, or &ldquo;Vitamin C&rdquo;.</p>
      <% } %>
      <div class="empty-actions">
        <a href="/medicines" class="btn btn-outline btn-sm">Browse all medicines</a>
      </div>
    </div>
  <% } %>
</section>

<%- include('../partials/footer', { year: new Date().getFullYear(), appName: appName }) %>
